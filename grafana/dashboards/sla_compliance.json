    {
      "title": "Error Budget Remaining — API (99.9% SLO)",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "((1 - 0.001) - rate(floww_api_request_duration_seconds_count{status=~\"5..\"}[24h]) / rate(floww_api_request_duration_seconds_count[24h])) * 100",
          "legendFormat": "24h budget %",
          "refId": "A"
        },
        {
          "expr": "((1 - 0.001) - rate(floww_api_request_duration_seconds_count{status=~\"5..\"}[7d]) / rate(floww_api_request_duration_seconds_count[7d])) * 100",
          "legendFormat": "7d budget %",
          "refId": "B"
        },
        {
          "expr": "((1 - 0.001) - rate(floww_api_request_duration_seconds_count{status=~\"5..\"}[30d]) / rate(floww_api_request_duration_seconds_count[30d])) * 100",
          "legendFormat": "30d budget %",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "title": "Error Budget Remaining — Ingestion (99% SLO)",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "((1 - 0.01) - (1 - avg_over_time(up{job=\"floww-ingestion\"}[24h]))) * 100",
          "legendFormat": "24h budget %",
          "refId": "A"
        },
        {
          "expr": "((1 - 0.01) - (1 - avg_over_time(up{job=\"floww-ingestion\"}[7d]))) * 100",
          "legendFormat": "7d budget %",
          "refId": "B"
        },
        {
          "expr": "((1 - 0.01) - (1 - avg_over_time(up{job=\"floww-ingestion\"}[30d]))) * 100",
          "legendFormat": "30d budget %",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "title": "p99 Latency — API & WebSocket (24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(floww_api_request_duration_seconds_bucket[24h])))",
          "legendFormat": "API p99",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(floww_websocket_message_duration_seconds_bucket[24h])))",
          "legendFormat": "WS p99",
          "refId": "B"
        },
        {
          "expr": "0.2",
          "legendFormat": "SLA Threshold (200ms)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "title": "Burn Rate — All SLOs (30d window)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(rate(floww_api_request_duration_seconds_count{status=~\"5..\"}[1h]) / rate(floww_api_request_duration_seconds_count[1h])) / 0.001",
          "legendFormat": "API Availability Burn Rate",
          "refId": "A"
        },
        {
          "expr": "(1 - avg_over_time(up{job=\"floww-ingestion\"}[1h])) / 0.01",
          "legendFormat": "Ingestion Burn Rate",
          "refId": "B"
        },
        {
          "expr": "1.64",
          "legendFormat": "Fast Burn Threshold",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 10,
          "custom": { "drawStyle": "line", "fillOpacity": 5 }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "table", "placement": "bottom" }
      }
    },
    {
      "title": "SLA Compliance Trend (30d)",
      "type": "timeseries",
