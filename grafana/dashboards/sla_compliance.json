    {
      "title": "SLA Target: 99.9%",
      "type": "text",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 2 },
      "options": {
        "mode": "markdown",
        "content": "**API SLA**\n\nTarget: **99.9%**\n\nBudget: **43.2 min/month**"
      }
