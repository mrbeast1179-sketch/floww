{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "Prometheus",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Ingestion Uptime %",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg_over_time(floww_ingestion_messages_total[1h]) / 3600 * 100",
          "legendFormat": "Uptime %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      },
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "justifyMode": "center"
      }
    },
    {
      "title": "API p99 Latency",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(floww_api_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 0.3 },
              { "color": "red", "value": 0.5 }
            ]
          },
          "unit": "s",
          "min": 0,
          "max": 2
        }
      }
    },
    {
      "title": "Cache Staleness (max delay)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "DuckDB",
      "targets": [
        {
          "sql": "SELECT MAX(delay_seconds) FROM ticks",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 900 },
              { "color": "red", "value": 3600 }
            ]
          },
          "unit": "s"
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "center"
      }
    },
    {
      "title": "Credit Burn Rate",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "floww_cost_budget_pct{provider=\"marketdata\"}",
          "legendFormat": "Budget %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "title": "Ingestion Rate (msg/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(floww_ingestion_messages_total[1m])",
          "legendFormat": "{{symbol}} — {{kind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      }
    },
    {
      "title": "p99 / p50 Latency (rolling 5m)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(floww_api_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p99"
        },
        {
          "expr": "histogram_quantile(0.50, rate(floww_api_request_duration_seconds_bucket[5m]))",
          "legendFormat": "p50"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "title": "Queue Depth",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "floww_duckdb_queue_depth",
          "legendFormat": "Queue"
        }
      ]
    },
    {
      "title": "429 Rate (per provider)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(floww_provider_calls_total{status=\"rate_limited\"}[5m])",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "title": "Credit Remaining ($)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 12 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "floww_cost_budget_usd - floww_cost_usd_daily",
          "legendFormat": "{{provider}} remaining"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      }
    },
    {
      "title": "Projected Month-End Cost",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "floww_cost_usd_daily * 30",
          "legendFormat": "Projected"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "center"
      }
    },
    {
      "title": "VPIN (SPY)",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 9, "x": 6, "y": 18 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "floww_vpin_current{ticker=\"SPY\"}",
          "legendFormat": "VPIN"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "title": "Provider Success Rate",
      "type": "timeseries",
      "gridPos": { "h": 4, "w": 9, "x": 15, "y": 18 },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "floww_provider_success_rate",
          "legendFormat": "{{provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        }
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["floww", "sla", "cost", "observability"],
  "templating": {
    "list": [
      {
        "name": "provider",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(floww_provider_calls_total, provider)",
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "America/New_York",
  "title": "Floww — SLA & Cost Dashboard",
  "uid": "floww-sla-cost",
  "version": 1
}
