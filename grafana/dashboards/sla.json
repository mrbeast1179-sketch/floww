    {
      "title": "Trade Execution Success Rate",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(1 - rate(floww_trade_execution_total{status=~\"failed|rejected|error\"}[24h]) / rate(floww_trade_execution_total[24h])) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": {
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      }
    },
    {
      "title": "Error Budget Remaining — API (99.9% SLA)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(1 - 0.001) * 86400 - (rate(floww_api_request_duration_seconds_count{status=~\"5..\"}[24h]) * 86400)",
          "legendFormat": "24h budget (seconds)",
          "refId": "A"
        },
        {
          "expr": "(1 - 0.001) * 604800 - (rate(floww_api_request_duration_seconds_count{status=~\"5..\"}[7d]) * 604800)",
          "legendFormat": "7d budget (seconds)",
          "refId": "B"
        },
        {
          "expr": "(1 - 0.001) * 2592000 - (rate(floww_api_request_duration_seconds_count{status=~\"5..\"}[30d]) * 2592000)",
          "legendFormat": "30d budget (seconds)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0 },
              { "color": "green", "value": 60 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "area"
      }
    },
    {
      "title": "Error Budget Remaining — Ingestion (99% SLA)",
